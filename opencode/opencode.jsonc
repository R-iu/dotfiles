{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-agent-browser"
  ],
  "instructions": [
    "./instructions/delta-diffs.md"
  ],
  "skills": {
    "paths": [
      "/home/riu/.config/opencode/open-design-skills/skills"
    ]
  },
  "mcp": {
    "blender-mcp": {
      "type": "local",
      "command": [
        "/usr/bin/uvx",
        "blender-mcp"
      ],
      "enabled": true,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      }
    },
    "mcp-server-chart": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@antv/mcp-server-chart"
      ],
      "enabled": true
    }
  },
  "permission": {
    "websearch": "allow"
  }
}
